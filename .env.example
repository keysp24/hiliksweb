# Contact form email delivery (app/api/contact/route.ts)
# Copy to .env.local for local dev, and set the same in Vercel →
# Project Settings → Environment Variables for production.

# Brevo API key — required for the server to actually send mail.
# Create one at https://app.brevo.com → SMTP & API → API Keys.
# Until this is set, the contact form gracefully falls back to opening the
# visitor's email client (mailto:).
BREVO_API_KEY=

# Verified Brevo sender. Either a bare address ("inquiries@hiliks.com") or
# "Name <address>" (e.g. "Hiliks Website <inquiries@hiliks.com>").
# The sender MUST be a verified sender/domain in your Brevo account
# (Brevo → Senders, Domains & Dedicated IPs). Defaults to the company inbox.
CONTACT_FROM_EMAIL=
